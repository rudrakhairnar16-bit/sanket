# MongoDB Connection String (get from MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sanket
MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/sanket

# JWT Secret for auth tokens (use a random string, min 32 chars)
JWT_SECRET=your-secret-key-change-in-production-at-least-32-chars-long

# Cloudinary cloud name (for video uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
